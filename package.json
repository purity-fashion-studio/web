{
  "name": "purity-fashion-studio",
  "version": "0.0.1",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx scripts/vercel-build.ts",
    "start": "next start",
    "setup": "tsx scripts/setup-project.ts",
    "lint": "eslint --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "env:check": "tsx scripts/check-env.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "cms:check": "tsx scripts/check-cms-contract.ts",
    "content:manifest": "tsx scripts/export-content-manifest.ts",
    "content:manifest:verify": "tsx scripts/export-content-manifest.ts --verify",
    "cms:bootstrap": "tsx payload/seed/import-seed.ts --bootstrap",
    "cms:restore": "tsx payload/seed/import-seed.ts --restore",
    "cms:verify": "tsx payload/seed/import-seed.ts --verify",
    "cms:locales": "tsx scripts/check-published-locales.ts",
    "cms:reset-preview": "tsx scripts/reset-preview.ts",
    "media:integrity": "tsx scripts/audit-media-integrity.ts",
    "release:check": "tsx scripts/check-resource-identity.ts",
    "payload": "payload",
    "payload:types": "payload generate:types",
    "payload:importmap": "payload generate:importmap",
    "payload:migrate": "payload migrate",
    "payload:migrate:create": "payload migrate:create",
    "payload:migrate:status": "payload migrate:status",
    "payment:check": "tsx scripts/check-payment-contract.ts",
    "payment:integration": "tsx scripts/check-payment-reliability.ts",
    "test:unit": "vitest run",
    "test:integration": "pnpm payment:integration && vitest run --config vitest.integration.config.ts",
    "knip": "knip",
    "qa:static": "tsx scripts/check-qa.ts",
    "qa:budget": "tsx scripts/check-performance-budget.ts",
    "qa:architecture": "tsx scripts/check-architecture.ts",
    "handoff:check": "tsx scripts/check-launch-handoff.ts",
    "test:e2e": "pnpm build && playwright test",
    "qa:all": "pnpm readiness:mvp && pnpm knip && pnpm audit --prod --audit-level low && pnpm test:unit && pnpm build && pnpm qa:architecture && pnpm qa:budget",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "tokens:check": "tsx scripts/check-design-tokens.ts",
    "brand:check": "tsx scripts/check-brand-assets.ts",
    "readiness:mvp": "pnpm env:check && pnpm typecheck && pnpm lint && pnpm content:validate && pnpm content:manifest:verify && pnpm cms:check && pnpm payment:check && pnpm release:check && pnpm qa:static && pnpm handoff:check && pnpm i18n:check && pnpm tokens:check && pnpm brand:check"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@next/env": "16.3.8",
    "@payloadcms/db-postgres": "3.90.0",
    "@payloadcms/email-resend": "3.90.0",
    "@payloadcms/live-preview-react": "3.90.0",
    "@payloadcms/next": "3.90.0",
    "@payloadcms/plugin-redirects": "3.90.0",
    "@payloadcms/plugin-seo": "3.90.0",
    "@payloadcms/richtext-lexical": "3.90.0",
    "@payloadcms/storage-vercel-blob": "3.90.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/blob": "2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.3.8",
    "next-intl": "^4.13.1",
    "payload": "3.90.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.81.0",
    "resend": "^6.17.2",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "knip": "^6.27.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vite": "8.1.6",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.28.1",
      "dompurify": "3.4.16",
      "drizzle-kit>esbuild": "0.28.1",
      "fast-uri": "3.1.9",
      "undici@>=6.0.0 <7.0.0": "6.28.1",
      "undici@>=7.0.0 <8.0.0": "7.29.1",
      "js-yaml": "4.3.2",
      "next>sharp": "0.35.5",
      "browserslist": "4.28.7",
      "baseline-browser-mapping": "2.11.0",
      "source-map-js": "1.2.2",
      "fast-copy": "3.1.0",
      "sass": "1.80.7",
      "@payloadcms/plugin-cloud-storage@3.90.0>find-node-modules": "-",
      "@modelcontextprotocol/sdk": "1.32.1",
      "@hono/node-server": "1.19.15",
      "hono": "4.13.13",
      "ip-address": "10.7.1",
      "proxy-addr": "2.0.8",
      "qs": "6.16.0",
      "smol-toml": "1.9.0",
      "postcss-selector-parser": "7.1.6",
      "brace-expansion@<2.0.0": "1.1.21",
      "brace-expansion@>=5.0.0 <6.0.0": "5.0.12",
      "minimatch@>=10.0.0 <11.0.0": "10.2.6",
      "postcss": ">=8.5.23",
      "vite>esbuild": "0.28.1"
    }
  }
}
